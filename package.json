{
  "name": "bismuth-ui",
  "version": "0.2.0",
  "type": "module",
  "description": "Vue 3 components cut from hexagons: 45° bevels drawn in CSS layers, an iridescent contour, and a theme that swaps with one custom property.",
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "design-system",
    "tailwindcss"
  ],
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/bismuth.cjs",
  "module": "./dist/bismuth.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bismuth.js",
      "require": "./dist/bismuth.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:lib": "vite build --mode lib && vue-tsc -p tsconfig.lib.json && node scripts/finish-types.mjs",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "@vueuse/core": "^13.0.0 || ^14.0.0",
    "motion-v": "^2.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "motion-v": "^2.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.40",
    "vue-tsc": "^3.3.8"
  }
}
